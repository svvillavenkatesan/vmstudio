{
  "1": {
    "inputs": {"ckpt_name": "v1-5-pruned-emaonly.safetensors"},
    "class_type": "CheckpointLoaderSimple",
    "_meta": {"title": "Load SD 1.5 Checkpoint"}
  },
  "2": {
    "inputs": {"text": "cinematic portrait, consistent character, authentic Tamil setting, detailed, no text", "clip": ["1", 1]},
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "$prompt.text!"}
  },
  "3": {
    "inputs": {"text": "text, letters, watermark, logo, blurry, deformed face, duplicate person, malformed hands", "clip": ["1", 1]},
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "$negative_prompt.text"}
  },
  "4": {
    "inputs": {"width": 512, "height": 768, "batch_size": 1},
    "class_type": "EmptyLatentImage",
    "_meta": {"title": "Portrait Canvas (fixed 4 GB VRAM size)"}
  },
  "5": {
    "inputs": {"model": ["1", 0], "preset": "PLUS FACE (portraits)"},
    "class_type": "IPAdapterUnifiedLoader",
    "_meta": {"title": "Load IP-Adapter Face"}
  },
  "6": {
    "inputs": {"image": "reference.png"},
    "class_type": "LoadImage",
    "_meta": {"title": "$reference_image.~image!"}
  },
  "7": {
    "inputs": {
      "model": ["5", 0], "ipadapter": ["5", 1], "image": ["6", 0],
      "weight": 0.72, "start_at": 0.0, "end_at": 0.85,
      "weight_type": "prompt is more important"
    },
    "class_type": "IPAdapter",
    "_meta": {"title": "Preserve Character Identity"}
  },
  "8": {
    "inputs": {
      "seed": 0, "steps": 18, "cfg": 6.5, "sampler_name": "euler",
      "scheduler": "normal", "denoise": 1.0, "model": ["7", 0],
      "positive": ["2", 0], "negative": ["3", 0], "latent_image": ["4", 0]
    },
    "class_type": "KSampler",
    "_meta": {"title": "Low VRAM Sampler, $seed.seed, $steps.steps, $cfg.cfg"}
  },
  "9": {
    "inputs": {"samples": ["8", 0], "vae": ["1", 2]},
    "class_type": "VAEDecode",
    "_meta": {"title": "Decode Image"}
  },
  "10": {
    "inputs": {"filename_prefix": "vmstudio_ipadapter", "images": ["9", 0]},
    "class_type": "SaveImage",
    "_meta": {"title": "Save Character Image"}
  }
}
